{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ScienceScope",
  "version": "1.0.0-alpha.0",
  "identifier": "org.sciencescope.desktop",
  "build": {
    "frontendDist": "../app/ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "decorations": false,
        "devtools": false,
        "title": "ScienceScope",
        "width": 1440,
        "height": 960,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "capabilities": ["main-window-controls"]
    }
  },
  "bundle": {
    "active": false,
    "icon": ["../tools/package/brand/icon.ico"]
  }
}
