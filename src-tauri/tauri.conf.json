{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ScienceScope",
  "version": "0.1.0",
  "identifier": "org.sciencescope.desktop",
  "build": {
    "frontendDist": "../.sciencescope-local/desktop-dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "decorations": false,
        "devtools": false,
        "title": "ScienceScope · 桌面开发版",
        "width": 1440,
        "height": 960,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "capabilities": ["main-window-controls"]
    }
  },
  "bundle": {
    "active": false,
    "icon": ["../.sciencescope-local/desktop-assets/icon.ico"]
  }
}
