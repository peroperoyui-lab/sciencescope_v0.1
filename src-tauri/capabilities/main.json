{
  "identifier": "main-window-controls",
  "description": "Local main window controls only; no filesystem or process execution.",
  "windows": ["main", "secondary-*"],
  "permissions": [
    "allow-open-secondary-window",
    "allow-set-assistant-mode",
    "allow-get-assistant-mode",
    "allow-show-assistant-menu",
    "allow-hide-assistant",
    "core:event:allow-listen",
    "core:event:allow-emit-to",
    "core:event:allow-unlisten",
    "core:window:allow-minimize",
    "core:window:allow-set-focus",
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging",
    "core:window:allow-inner-size",
    "core:window:allow-scale-factor",
    "core:window:allow-is-maximized",
    "core:window:allow-is-fullscreen",
    "core:window:allow-set-fullscreen",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-is-visible"
  ]
}
