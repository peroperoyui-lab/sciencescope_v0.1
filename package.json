{
  "name": "sciencescope-desktop",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "desktop:prepare": "node scripts/build-desktop.mjs",
    "desktop:preview": "node scripts/preview-desktop.mjs",
    "test": "node --test --test-concurrency=2 tests/*.test.mjs",
    "start:app": "node app/main.js",
    "test:app": "node --test --test-concurrency=2 \"app/**/*.test.js\"",
    "format": "prettier --write app",
    "lint": "eslint app",
    "typecheck": "tsc -p app",
    "check": "prettier --check app && eslint app && tsc -p app && node --test --test-concurrency=2 \"app/**/*.test.js\""
  },
  "dependencies": {
    "@codemirror/language": "6.12.4",
    "@codemirror/legacy-modes": "6.5.4",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@deepseek-ai/dsh": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-sdk-client": "0.1.6-alpha.1",
    "@fontsource-variable/noto-sans-sc": "5.3.0",
    "@huggingface/transformers": "4.3.0",
    "diff": "^9.0.0",
    "docx-preview": "0.4.1",
    "dompurify": "3.4.16",
    "highlight.js": "11.12.0",
    "htm": "3.1.1",
    "jszip": "3.10.1",
    "katex": "0.18.9",
    "mammoth": "1.12.3",
    "marked": "18.0.13",
    "onnxruntime-node": "1.30.0",
    "papaparse": "5.7.0",
    "parse5": "8.0.1",
    "pdfjs-dist": "6.3.289",
    "preact": "11.0.0",
    "sqlite-vec": "0.1.9",
    "trash": "10.1.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@pdf-lib/fontkit": "1.1.1",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "globals": "17.13.0",
    "pdf-lib": "1.17.1",
    "playwright-core": "1.63.0",
    "prettier": "3.9.9",
    "typescript": "5.9.3"
  }
}
